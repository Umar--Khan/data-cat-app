# Commented assignments show the code default, so a later change to it still reaches this checkout.
# Uncomment one only to override it.

# auto (Claude when ANTHROPIC_API_KEY is set, keyword otherwise), keyword, or anthropic (requires the key)
# CATALOGUE_CURATION_PROVIDER=auto
# Enables Claude under auto. A key exported in the shell counts too. Never commit a real key.
ANTHROPIC_API_KEY=
# Anthropic API host
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Only for a key that is not scoped to a workspace: sent as the anthropic-workspace-id header
# ANTHROPIC_WORKSPACE_ID=
# Claude model used for curation
# CATALOGUE_ANTHROPIC_MODEL=claude-opus-5-5
# Total curation budget in seconds, retries included
# CATALOGUE_ANTHROPIC_TIMEOUT_SECONDS=20
# Simulated keyword-curator latency, so the pending state is visible in dev (default 0)
CATALOGUE_KEYWORD_DELAY_MS=1200
# Browser origins allowed to call the API, as a JSON list of scheme://host:port, no trailing slash
# CATALOGUE_CORS_ORIGINS=["http://localhost:5173"]
# DEBUG, INFO, WARNING or ERROR, for the catalogue loggers
# CATALOGUE_LOG_LEVEL=INFO
